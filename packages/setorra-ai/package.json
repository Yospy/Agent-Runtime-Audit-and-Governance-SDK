  "description": "Setorra Node/TypeScript SDK (setorra-ai): handshake + organization stamping with privacy-first redaction (Python parity)",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
