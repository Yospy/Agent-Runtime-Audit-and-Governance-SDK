{
  "version": "2025-10-30",
  "metadata": {
    "org_id": "zenith-labs",
    "owner": "enterprise-security",
    "description": "Zenith policy: allow basic create; require approval for large attendee lists; deny deletes"
  },
  "sdk": {
    "decision": "allow",
    "fail_mode": "fail-open"
  },
  "defaults": {
    "decision": "allow",
    "fail_mode": "fail-closed"
  },
  "actions": {
    "agent.invoke": {
      "default_decision": "allow",
      "fail_mode": "fail-open",
      "rules": []
    },
    "calendar.view": {
      "default_decision": "allow",
      "fail_mode": "fail-closed",
      "rules": []
    },
    "calendar.delete": {
      "default_decision": "deny",
      "fail_mode": "fail-closed",
      "rules": []
    },
    "calendar.update": {
      "default_decision": "allow",
      "fail_mode": "fail-closed",
      "rules": []
    },
    "calendar.create": {
      "default_decision": "allow",
      "fail_mode": "fail-closed",
      "rules": [
        {
          "id": "attendee-count-high",
          "decision": "require_approval",
          "match": {
            "parameters.arguments.attendees_count": { "gt": 10 }
          },
          "approval": {
            "requires_token": true,
            "expires_in": 900,
            "metadata": {
              "reason": "large_meeting"
            }
          },
          "rationale": "Large meetings require explicit approval"
        }
      ]
    }
  }
}

